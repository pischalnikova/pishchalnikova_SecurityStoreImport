@model ImportPageModel
@{
    ViewData["Title"] = "Импорт из CSV";
    var result = Model.Result; // результат последнего импорта или null
}

<h1>Импорт из CSV</h1>
<p class="subtitle">Выберите один из двух способов загрузки</p>

<div class="steps">
    <form class="panel" method="post" asp-action="Import" enctype="multipart/form-data">
        <h2>Способ 1. Файл с компьютера</h2>
        <input type="hidden" name="Mode" value="@ImportRequest.UploadMode" />
        <input type="file" name="File" accept=".csv" /><br />
        <button type="submit" class="btn">Загрузить и импортировать</button>
    </form>

    <form class="panel" method="post" asp-action="Import">
        <h2>Способ 2. Путь к файлу</h2>
        <input type="hidden" name="Mode" value="@ImportRequest.PathMode" />
        <input type="text" name="FilePath" value="@Model.FilePath" placeholder="/csv/samples/catalog.csv" />
        <button type="submit" class="btn">Импортировать товары</button>
        <p class="hint">Путь от папки wwwroot или полный путь на диске.</p>
    </form>
</div>

@if (result != null)
{
    <div class="panel">
        <h2>Итог импорта @(result.FileName != "" ? "«" + result.FileName + "»" : "")</h2>

        @if (result.ImportedCount > 0 && result.Errors.Count == 0)
        {
            <div class="message message-ok">Файл загружен полностью, ошибок нет.</div>
        }
        else if (result.ImportedCount == 0)
        {
            <div class="message message-error">Товары не добавлены — смотрите список ошибок.</div>
        }

        <table class="counts">
            <tr><th>Показатель</th><th>Значение</th></tr>
            <tr><td>Всего строк</td><td>@result.TotalRows</td></tr>
            <tr><td>Успешно импортировано</td><td>@result.ImportedCount</td></tr>
            <tr><td>Ошибки</td><td>@result.ErrorCount</td></tr>
            <tr><td>Предупреждения</td><td>@result.WarningCount</td></tr>
            @if (result.Encoding != "")
            {
                <tr><td>Кодировка файла</td><td>@result.Encoding</td></tr>
            }
        </table>

        @if (result.Errors.Count > 0)
        {
            <h2 style="margin-top:24px">Список ошибок</h2>
            <table>
                <tr><th>Строка</th><th>Поле</th><th>Описание</th></tr>
                @foreach (var error in result.Errors)
                {
                    <tr class="@(error.IsWarning ? "warning-row" : "error-row")">
                        <td>@(error.RowNumber == 0 ? "—" : error.RowNumber.ToString())</td>
                        <td>@(error.Column == "" ? "—" : error.Column)</td>
                        <td>@(error.IsWarning ? "Предупреждение: " : "")@error.Message</td>
                    </tr>
                }
            </table>
        }

        <p style="margin-top:18px"><a asp-action="Index" class="btn">Открыть каталог</a></p>
    </div>
}

<div class="panel">
    <h2>Требования к файлу</h2>
    <p>Первая строка — заголовки колонок, разделитель <b>,</b> <b>;</b> или табуляция, кодировка UTF-8 или Windows-1251.</p>
    <p class="hint">sku, name, description, price, currency, category_name, stock, image_url, is_active, brand, system_type, model, ip_rating</p>
    <p>Примеры для проверки — в папке <b>wwwroot/csv/samples</b>.</p>
</div>
