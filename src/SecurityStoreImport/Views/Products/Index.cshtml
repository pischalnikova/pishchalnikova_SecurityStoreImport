@model ProductListViewModel
@{
    ViewData["Title"] = "Каталог";
}

@section Side {
    @if (Model.TotalInCatalog > 0)
    {
        <form method="get" asp-action="Index">
            <h3>Поиск</h3>
            <input type="text" name="search" value="@Model.Search" placeholder="название, бренд, артикул" />

            <h3>Тип системы</h3>
            <label><input type="radio" name="system" value="" checked="@string.IsNullOrEmpty(Model.System)" /> Все</label>
            @foreach (var type in ImportRules.SystemTypes)
            {
                <label><input type="radio" name="system" value="@type" checked="@(Model.System == type)" /> @type</label>
            }

            <h3>Сортировка</h3>
            <select name="sort">
                <option value="">как в файле</option>
                <option value="price_up" selected="@(Model.Sort == "price_up")">сначала дешёвые</option>
                <option value="price_down" selected="@(Model.Sort == "price_down")">сначала дорогие</option>
                <option value="stock_up" selected="@(Model.Sort == "stock_up")">меньше на складе</option>
            </select>

            <button type="submit" class="btn">Показать</button>
            <a asp-action="Index" class="btn btn-gray">Сброс</a>
        </form>
    }
}

<h1>Каталог товаров</h1>
<p class="subtitle">Видеонаблюдение, охранная сигнализация, контроль доступа</p>

@if (Model.TotalInCatalog == 0)
{
    <div class="panel">
        <h2>Каталог пуст</h2>
        <p>Чтобы товары появились, загрузите CSV-файл.</p>
        <a asp-action="Import" class="btn">Перейти к импорту</a>
    </div>
}
else
{
    @if (Model.Products.Count == 0)
    {
        <div class="message message-info">Под условия поиска ничего не подходит.</div>
    }

    <div class="cards">
        @foreach (var p in Model.Products)
        {
            <div class="card system-@Array.IndexOf(ImportRules.SystemTypes, p.SystemType)">
                <span class="sku">@p.Sku · @p.SystemType</span>
                <a class="name" asp-action="Details" asp-route-id="@p.Sku">@p.Name</a>
                <span class="brand">@p.Brand @p.Model · @p.CategoryName</span>
                <div class="bottom">
                    <span class="price">@p.Price.ToString("N0") @p.Currency</span>
                    <span class="stock">
                        на складе: @p.StockQuantity<br />
                        @if (p.IsActive) { <span>в продаже</span> } else { <span class="off">не продаётся</span> }
                    </span>
                </div>
            </div>
        }
    </div>

    <p class="summary-line">
        Показано @Model.Products.Count из @Model.TotalInCatalog.
        Стоимость остатков: @Model.TotalValue.ToString("N0") ₽.
    </p>

    <form method="post" asp-action="Clear" onsubmit="return confirm('Очистить список товаров? Данные из памяти будут удалены.');">
        <button type="submit" class="btn btn-gray">Очистить каталог</button>
    </form>
}
