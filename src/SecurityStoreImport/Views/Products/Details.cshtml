@model Product
@{
    ViewData["Title"] = Model.Name;
}

<p><a asp-action="Index">← в каталог</a></p>

<div class="panel">
    <p class="hint">@Model.SystemType · @Model.CategoryName</p>
    <h1>@Model.Name</h1>
    <div class="big-price">@Model.Price.ToString("N2") @Model.Currency</div>
    <p>@(Model.Description == "" ? "Описание отсутствует" : Model.Description)</p>

    <table class="props">
        <tr><td>Артикул</td><td>@Model.Sku</td></tr>
        <tr><td>Производитель</td><td>@Model.Brand</td></tr>
        <tr><td>Модель</td><td>@(Model.Model == "" ? "—" : Model.Model)</td></tr>
        <tr><td>Степень защиты</td><td>@(Model.IpRating == "" ? "—" : Model.IpRating)</td></tr>
        <tr><td>Остаток на складе</td><td>@Model.StockQuantity шт.</td></tr>
        <tr><td>В продаже</td><td>@(Model.IsActive ? "да" : "нет")</td></tr>
        <tr><td>Изображение</td><td>@(Model.ImageUrl == "" ? "—" : Model.ImageUrl)</td></tr>
    </table>
</div>
