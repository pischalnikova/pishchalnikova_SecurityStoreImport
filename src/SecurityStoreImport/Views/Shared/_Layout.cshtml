@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Гардиан</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
<div class="page">
    <aside class="side">
        <a class="logo" asp-controller="Products" asp-action="Index">
            <b>ГАРДИАН</b>
            <small>оборудование для систем безопасности</small>
        </a>

        <nav class="menu">
            <a asp-controller="Products" asp-action="Index" class="@(action == "Index" ? "active" : "")">Каталог товаров</a>
            <a asp-controller="Products" asp-action="Import" class="@(action == "Import" ? "active" : "")">Импорт из CSV</a>
            <a asp-controller="Products" asp-action="Export">Скачать каталог (CSV)</a>
        </nav>

        @await RenderSectionAsync("Side", required: false)

        <div class="about">ГК «Гардиан», г. Пермь<br />Практика ПП.02.01</div>
    </aside>

    <main class="main">
        @if (TempData["Notice"] is string notice)
        {
            <div class="message message-ok">@notice</div>
        }
        @RenderBody()
    </main>
</div>
</body>
</html>
